# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# In deployed environments, inject these as real environment variables / via a
# secrets manager. Do NOT ship a .env file to production.
# This file documents the variable names only; every value here is a placeholder.

APP_NAME="Rhema Pod"
# One of: development | test | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost/DBNAME

REDIS_URL=redis://127.0.0.1:6379/0

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ chars of real randomness. Placeholder / low-entropy values are
# rejected at boot, in every environment.
SECRET_KEY=replace-with-a-generated-random-value

S3_MEDIA_BUCKET=your-media-bucket
S3_RAW_BUCKET=your-raw-bucket
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional — leave unset to route reads to the primary
# DATABASE_REPLICA_URL=postgresql+psycopg://USER:PASSWORD@replica-host:5432/DBNAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email — SMTP_HOST + SMTP_FROM_EMAIL both set is what flips settings.email_is_live
# true; without them, invite/reset emails are only logged (console backend), and
# the production preflight refuses to boot. Using Resend's SMTP relay (see
# DEPLOYMENT.md §7) needs no code change, just these five values:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587                    # or 465 for implicit TLS
#   SMTP_USERNAME=resend             # literally the word "resend"
#   SMTP_PASSWORD=your-resend-api-key
#   SMTP_FROM_EMAIL=notifications@your-verified-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudflare Stream — mobile app media pipeline (plans/plan-mobile-app.md,
# W0.1-W1.6). app/core/stream.py reads CF_ACCOUNT_ID/CF_STREAM_API_TOKEN/
# CF_STREAM_CUSTOMER_SUBDOMAIN/CF_STREAM_WEBHOOK_SECRET/
# CF_STREAM_SIGNING_KEY_ID/CF_STREAM_SIGNING_KEY_PEM — see DEPLOYMENT.md §12.
# Placeholders only. Real values live in docker-compose.override.yml
# (gitignored, container-only), never here, for the same reason as the SMTP
# creds above. CF_STREAM_SIGNING_KEY_ID/_PEM (W1.5) sign playback URLs; both
# come from ONE `POST /accounts/{id}/stream/keys` call — Cloudflare returns
# the PEM exactly once, at creation time. CF_STREAM_SIGNING_KEY_PEM must be a
# single line with literal "\n" in place of real newlines (Settings
# unescapes it — see app/core/config.py's normalize_signing_key_pem).
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_SUBDOMAIN=
CF_STREAM_WEBHOOK_SECRET=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
