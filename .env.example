APP_NAME="Rhema Pod"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://sermonuser:sermonpass@localhost/sermon

REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

S3_MEDIA_BUCKET = fastapi-blog-s3-bucket
S3_RAW_BUCKET = fastapi-blog-s3-bucket
S3_REGION = eu-north-1
S3_ACCESS_KEY_ID = ***REMOVED-AWS-ACCESS-KEY***
S3_SECRET_ACCESS_KEY = ***REMOVED-AWS-SECRET-KEY***

# Optional — leave unset to route reads to the primary
# DATABASE_REPLICA_URL=postgresql://sermon:sermon@replica-host:5432/sermon_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]