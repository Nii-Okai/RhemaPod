# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# In deployed environments, inject these as real environment variables / via a
# secrets manager. Do NOT ship a .env file to production.
# This file documents the variable names only; every value here is a placeholder.

APP_NAME="Rhema Pod"
# One of: development | test | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost/DBNAME

REDIS_URL=redis://127.0.0.1:6379/0

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ chars of real randomness. Placeholder / low-entropy values are
# rejected at boot, in every environment.
SECRET_KEY=replace-with-a-generated-random-value

# Live object store: Cloudflare R2 (decision (a) — S3 now names the archive
# vendor only). Endpoint is the R2 account-scoped S3 API URL, always https —
# see app/core/config.py's object_store_endpoint_is_https, which now runs in
# every environment, including development. Real values live in
# docker-compose.override.yml (gitignored) for container-based dev, never
# here.
OBJECT_STORE_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORE_MEDIA_BUCKET=your-media-bucket
OBJECT_STORE_RAW_BUCKET=your-raw-bucket
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

# Cold-tier archive: AWS S3 Deep Archive (plan L2). A genuine cross-vendor
# copy target, not the same account as the live store above. Region is a
# real AWS region (no "auto" shortcut, unlike R2). Storage class is one of
# DEEP_ARCHIVE | GLACIER; production requires DEEP_ARCHIVE.
ARCHIVE_STORE_BUCKET=your-archive-bucket
ARCHIVE_STORE_REGION=
ARCHIVE_STORE_ACCESS_KEY_ID=
ARCHIVE_STORE_SECRET_ACCESS_KEY=
ARCHIVE_STORE_STORAGE_CLASS=DEEP_ARCHIVE
# Only turn this on once both stores above are live (both refused
# otherwise, in every environment) and the restore drill (plan R5.1) has
# passed.
ARCHIVE_DELETE_SOURCE=false
ARCHIVE_SOURCE_RETENTION_DAYS=14
ARCHIVE_LEASE_MINUTES=120

# Optional — leave unset to route reads to the primary
# DATABASE_REPLICA_URL=postgresql+psycopg://USER:PASSWORD@replica-host:5432/DBNAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email — SMTP_HOST + SMTP_FROM_EMAIL both set is what flips settings.email_is_live
# true; without them, invite/reset emails are only logged (console backend), and
# the production preflight refuses to boot. Using Resend's SMTP relay (see
# DEPLOYMENT.md §7) needs no code change, just these five values:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587                    # or 465 for implicit TLS
#   SMTP_USERNAME=resend             # literally the word "resend"
#   SMTP_PASSWORD=your-resend-api-key   # never commit the real key
#   SMTP_FROM_EMAIL=RhemaPod <no-reply@rhemapod.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Transport: smtp (default) or resend_api (HTTPS to api.resend.com:443, for hosts
# that block outbound SMTP, e.g. Render free tier). resend_api needs
# RESEND_API_KEY + SMTP_FROM_EMAIL.
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
# Self-registered (email/password) app users confirm their address with an
# emailed 6-digit code before they can sign in. Must stay true in production.
REQUIRE_EMAIL_VERIFICATION=true

# Cloudflare Stream — mobile app media pipeline (plans/plan-mobile-app.md,
# W0.1-W1.6). app/core/stream.py reads CF_ACCOUNT_ID/CF_STREAM_API_TOKEN/
# CF_STREAM_CUSTOMER_SUBDOMAIN/CF_STREAM_WEBHOOK_SECRET/
# CF_STREAM_SIGNING_KEY_ID/CF_STREAM_SIGNING_KEY_PEM — see DEPLOYMENT.md §12.
# Placeholders only. Real values live in docker-compose.override.yml
# (gitignored, container-only), never here, for the same reason as the SMTP
# creds above. CF_STREAM_SIGNING_KEY_ID/_PEM (W1.5) sign playback URLs; both
# come from ONE `POST /accounts/{id}/stream/keys` call — Cloudflare returns
# the PEM exactly once, at creation time. CF_STREAM_SIGNING_KEY_PEM must be a
# single line with literal "\n" in place of real newlines (Settings
# unescapes it — see app/core/config.py's normalize_signing_key_pem).
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_SUBDOMAIN=
CF_STREAM_WEBHOOK_SECRET=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=

# Sermon comments: auto-hide after this many distinct reporters (default 3)
COMMENTS_AUTO_HIDE_THRESHOLD=3

# System audit log retention (app/scripts/purge_audit_log.py), in days.
# auth.* rows are deleted past AUDIT_AUTH_RETENTION_DAYS; ip/user_agent are
# nulled on EVERY row past AUDIT_NETWORK_RETENTION_DAYS (ADR 0018 addendum).
AUDIT_AUTH_RETENTION_DAYS=365
AUDIT_NETWORK_RETENTION_DAYS=30

# In-process daily retention loop (audit + moderation snapshots). Leave false
# where a real scheduler runs the app/scripts purge CLIs; true on Render free.
RETENTION_SCHEDULER_ENABLED=false

# app/scripts/seed_staff.py — creates/promotes the fixed real staff accounts
# (admin@rhemapod.com, manager1@/manager2@, editor1@/editor2@). Placeholders
# only; the script refuses to run with any of these unset.
STAFF_ADMIN_PASSWORD=
STAFF_MANAGER1_PASSWORD=
STAFF_MANAGER2_PASSWORD=
STAFF_EDITOR1_PASSWORD=
STAFF_EDITOR2_PASSWORD=

# Account deletion + Apple token revocation (ADR 0020, DEPLOYMENT.md §13).
# Stay on stub until the Apple key is provisioned; OAUTH_APPLE_ENABLED=true
# in production refuses to boot on stub or a missing/non-P-256 key.
APPLE_REVOCATION_BACKEND=stub
APPLE_TEAM_ID=FAND2W5VMM
APPLE_KEY_ID=
# PEM contents (not a path). Either real newlines or ONE double-quoted line
# with literal \n escapes: "-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=
# Defaults to the first APPLE_OAUTH_AUDIENCES entry when blank.
APPLE_CLIENT_ID=
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS=300
ACCOUNT_DELETE_RATE_LIMIT=5
ACCOUNT_DELETE_RATE_WINDOW_SECONDS=3600
