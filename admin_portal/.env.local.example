# RhemaPod admin portal — local configuration (plan §A.8).
# Copy to .env.local (gitignored) for local dev.
#
# Both values are SERVER-ONLY. There is deliberately no NEXT_PUBLIC_* variable
# in Phase 1 — if one appears, something that should stay server-side has leaked
# to the browser.

# FastAPI service base URL. Server-to-server only; the browser never calls it
# directly (everything goes through the Next BFF). Local Docker stack:
API_BASE_URL=http://127.0.0.1:8000

# The portal's own origin. The BFF Origin / Sec-Fetch-Site CSRF check compares
# every mutating request against this exact value.
PORTAL_ORIGIN=http://localhost:3000

# Name of the inbound header the portal's OWN infrastructure (a fronting nginx,
# a platform load balancer) sets from the real client TCP connection — e.g.
# `x-real-ip`. The BFF reads the client IP ONLY from this header, validates it
# with net.isIP(), and forwards it as a single X-Forwarded-For to FastAPI so the
# backend rate limiter keys per staff member.
#
# Leave UNSET for pure `npm run dev` with nothing in front of the BFF: no
# X-Forwarded-For is forwarded and the backend rate-limits per-BFF (fine for
# single-user dev; app.core.net logs a `client_ip_fallback` each request).
#
# SECURITY: never point this at a header the browser can set (the BFF is the
# edge in dev/compose — inbound X-Forwarded-For / X-Real-IP are attacker input).
# A real multi-user deployment MUST set this from a trusted hop, or per-user
# rate limiting degrades to per-BFF.
# CLIENT_IP_HEADER=x-real-ip
