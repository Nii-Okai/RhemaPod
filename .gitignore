dump.rdb
*.sqlite
*.db

# OS
.DS_Store

# Project-specific
# Ignore docs/ contents by default, but TRACK ADRs and code reviews. Git cannot
# re-include a path whose parent dir is wholesale-excluded, so exclude the
# entries (docs/*) rather than the directory (docs/) — that keeps git
# recursing so the negations below take effect. The design bundle
# docs/design_admin_portal/ stays ignored.
docs/*
!docs/adr/
!docs/adr/**
!docs/reviews/
!docs/reviews/**
status.md

# Expo / React Native mobile artifacts
.expo/
.expo-shared/
dist/
*.tsbuildinfo
mobile/node_modules/
# Managed Expo workflow (Expo Router, no eject) — ios/ and android/ are
# `expo prebuild` output, regenerated on demand, never source. Whole
# directories ignored, not just their own build artifacts (a bare-workflow
# assumption the narrower entries below used to make).
mobile/ios/
mobile/android/
mobile/spike/ios/
mobile/spike/android/

# Local Docker Compose override (auto-loaded by `docker compose`). Used on
# machines where a host-native Postgres already holds 127.0.0.1:5432 — the
# override republishes the container's Postgres on 5433. Never committed:
# CI and other machines must use the plain compose file.
docker-compose.override.yml
docker-compose.override.yaml
