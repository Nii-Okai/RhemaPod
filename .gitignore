# Secrets — NEVER commit
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key

# Python-generated files
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data
dump.rdb
*.sqlite
*.db

# OS
.DS_Store

# Project-specific
# Ignore docs/ contents by default, but TRACK ADRs and code reviews. Git cannot
# re-include a path whose parent dir is wholesale-excluded, so exclude the
# entries (docs/*) rather than the directory (docs/) — that keeps git
# recursing so the negations below take effect. The design bundle
# docs/design_admin_portal/ stays ignored.
docs/*
!docs/adr/
!docs/adr/**
!docs/reviews/
!docs/reviews/**
status.md
