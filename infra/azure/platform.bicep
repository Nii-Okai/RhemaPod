// Platform layer: what the environments in one resource group share.
//
//   nonprod  (rg-rhemapod-nonprod) → hosts the dev and test environments
//   prod     (rg-rhemapod-prod)    → hosts production only
//
// Creates the Container Apps environment (in its own VNet), Log Analytics,
// one PostgreSQL flexible server with a database per environment, Redis, and a
// platform Key Vault holding the generated Postgres admin and Redis passwords.
// The per-environment apps (main.bicep) are deployed on top of this.
//
// Deploy with infra/azure/deploy.sh platform <nonprod|prod> (DEPLOYMENT-AZURE.md).

targetScope = 'resourceGroup'

@allowed(['nonprod', 'prod'])
param platformName string

param location string = resourceGroup().location

@description('Object id of the person running the deployment. Gets Key Vault Secrets Officer on the platform vault so deploy.sh can read the generated passwords back.')
param deployerObjectId string

// ── Network ──────────────────────────────────────────────────────────────────
param vnetAddressPrefix string = '10.40.0.0/16'

@description('Container Apps infrastructure subnet. The ingress proxies live here, so this CIDR is also the API\'s TRUSTED_PROXIES value (main.bicep).')
param infrastructureSubnetPrefix string = '10.40.0.0/23'

// ── Postgres ─────────────────────────────────────────────────────────────────
param postgresSkuName string = 'Standard_B1ms'
param postgresSkuTier string = 'Burstable'
param postgresStorageSizeGB int = 32
param postgresBackupRetentionDays int = 7

@description('One database per environment hosted here, e.g. [\'rhemapod_dev\', \'rhemapod_test\'].')
param databaseNames array

@secure()
@description('Generated by deploy.sh on the first run and stored in this platform\'s Key Vault; passed back unchanged afterwards.')
param postgresAdminPassword string

// ── Redis ────────────────────────────────────────────────────────────────────
@description('container: a small Redis container inside the Container Apps environment (no persistence, a restart signs everyone out). managed: Azure Managed Redis.')
@allowed(['container', 'managed'])
param redisMode string

@secure()
@description('container mode only: the requirepass value, generated by deploy.sh. Ignored in managed mode, where Azure generates the access key.')
param redisPassword string = ''

param managedRedisSku string = 'Balanced_B0'
param managedRedisHighAvailability bool = false

// ── Cost guardrails (DEPLOYMENT-AZURE.md §10) ───────────────────────────────
@description('Monthly budget for everything in this resource group, in the billing currency. Alerts only: Azure never stops resources when it is exceeded.')
param monthlyBudget int

@description('Who gets the budget alerts. Passed in by deploy.sh from BUDGET_ALERT_EMAILS, never committed.')
param budgetAlertEmails array

@description('First day of the current month; a budget must start on one.')
param budgetStartDate string = utcNow('yyyy-MM-01')

@description('Log Analytics ingestion stops for the rest of the day at this size. The first 5 GB a month are free.')
param logDailyCapGb string

@description('Lets Postgres storage grow on its own when nearly full. Storage can never shrink back, so it stays off where an outage is cheap.')
param postgresStorageAutoGrow bool

param tags object = {}

var suffix = take(uniqueString(resourceGroup().id), 6)
var allTags = union(tags, { app: 'rhemapod', platform: platformName })
var alertEmails = filter(budgetAlertEmails, e => !empty(trim(e)))

// Built-in role definition ids.
var keyVaultSecretsOfficer = 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'

// ── Logs ─────────────────────────────────────────────────────────────────────
resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-rhemapod-${platformName}'
  location: location
  tags: allTags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
    workspaceCapping: {
      dailyQuotaGb: json(logDailyCapGb)
    }
  }
}

// Emails at 50% and 80% of the budget spent, 100% spent, and when Azure
// forecasts the month will go over.
resource budget 'Microsoft.Consumption/budgets@2023-11-01' = if (!empty(alertEmails)) {
  name: 'budget-rhemapod-${platformName}'
  properties: {
    category: 'Cost'
    amount: monthlyBudget
    timeGrain: 'Monthly'
    timePeriod: {
      startDate: budgetStartDate
    }
    notifications: {
      actual50: {
        enabled: true
        operator: 'GreaterThanOrEqualTo'
        threshold: 50
        thresholdType: 'Actual'
        contactEmails: alertEmails
      }
      actual80: {
        enabled: true
        operator: 'GreaterThanOrEqualTo'
        threshold: 80
        thresholdType: 'Actual'
        contactEmails: alertEmails
      }
      actual100: {
        enabled: true
        operator: 'GreaterThanOrEqualTo'
        threshold: 100
        thresholdType: 'Actual'
        contactEmails: alertEmails
      }
      forecast100: {
        enabled: true
        operator: 'GreaterThanOrEqualTo'
        threshold: 100
        thresholdType: 'Forecasted'
        contactEmails: alertEmails
      }
    }
  }
}

// ── Network ──────────────────────────────────────────────────────────────────
resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: 'vnet-rhemapod-${platformName}'
  location: location
  tags: allTags
  properties: {
    addressSpace: { addressPrefixes: [vnetAddressPrefix] }
    subnets: [
      {
        name: 'container-apps'
        properties: {
          addressPrefix: infrastructureSubnetPrefix
          defaultOutboundAccess: true
          delegations: [
            {
              name: 'container-apps'
              properties: { serviceName: 'Microsoft.App/environments' }
            }
          ]
        }
      }
    ]
  }
}

// ── Container Apps environment ───────────────────────────────────────────────
// A VNet-integrated, workload-profiles environment on the Consumption profile:
// pay per use, scale to zero, and internal TCP ingress for the Redis container.
resource cae 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: 'cae-rhemapod-${platformName}'
  location: location
  tags: allTags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
    vnetConfiguration: {
      infrastructureSubnetId: vnet.properties.subnets[0].id
      internal: false
    }
    workloadProfiles: [
      {
        name: 'Consumption'
        workloadProfileType: 'Consumption'
      }
    ]
  }
}

// ── Platform Key Vault ───────────────────────────────────────────────────────
resource kv 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'kv-rp-${platformName}-${suffix}'
  location: location
  tags: allTags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 30
    enablePurgeProtection: platformName == 'prod' ? true : null
  }
}

resource deployerSecretsOfficer 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: kv
  name: guid(kv.id, deployerObjectId, keyVaultSecretsOfficer)
  properties: {
    principalId: deployerObjectId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', keyVaultSecretsOfficer)
  }
}

resource pgPasswordSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: kv
  name: 'postgres-admin-password'
  properties: { value: postgresAdminPassword }
}

// ── Postgres ─────────────────────────────────────────────────────────────────
module postgres 'modules/postgres.bicep' = {
  name: 'postgres-${platformName}'
  params: {
    name: 'psql-rhemapod-${platformName}-${suffix}'
    location: location
    tags: allTags
    skuName: postgresSkuName
    skuTier: postgresSkuTier
    storageSizeGB: postgresStorageSizeGB
    backupRetentionDays: postgresBackupRetentionDays
    storageAutoGrow: postgresStorageAutoGrow
    administratorLoginPassword: postgresAdminPassword
    databaseNames: databaseNames
  }
}

// ── Redis: container mode ────────────────────────────────────────────────────
// Internal TCP ingress only: reachable from apps in this environment as
// rhemapod-<platform>-redis:6379, never from the internet. No persistence and
// noeviction, the same posture as the Render free Key Value. Environments that
// share it use different database numbers (main.bicep redisDatabase).
resource redisApp 'Microsoft.App/containerApps@2024-03-01' = if (redisMode == 'container') {
  name: 'rhemapod-${platformName}-redis'
  location: location
  tags: allTags
  properties: {
    environmentId: cae.id
    workloadProfileName: 'Consumption'
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: false
        transport: 'tcp'
        targetPort: 6379
        exposedPort: 6379
      }
      secrets: [
        { name: 'redis-password', value: redisPassword }
      ]
    }
    template: {
      containers: [
        {
          name: 'redis'
          image: 'docker.io/library/redis:7.4-alpine'
          command: ['sh', '-c']
          args: [
            'exec redis-server --requirepass "$REDIS_PASSWORD" --save "" --appendonly no --maxmemory 400mb --maxmemory-policy noeviction'
          ]
          env: [
            { name: 'REDIS_PASSWORD', secretRef: 'redis-password' }
          ]
          resources: {
            cpu: json('0.25')
            memory: '0.5Gi'
          }
        }
      ]
      scale: {
        minReplicas: 1
        maxReplicas: 1
      }
    }
  }
}

// ── Redis: managed mode ──────────────────────────────────────────────────────
// Azure Managed Redis (Azure Cache for Redis no longer accepts new customers).
// TLS on port 10000, access-key auth, noeviction so refresh sessions are never
// dropped to make room.
resource managedRedis 'Microsoft.Cache/redisEnterprise@2025-04-01' = if (redisMode == 'managed') {
  name: 'redis-rhemapod-${platformName}-${suffix}'
  location: location
  tags: allTags
  sku: { name: managedRedisSku }
  properties: {
    minimumTlsVersion: '1.2'
    highAvailability: managedRedisHighAvailability ? 'Enabled' : 'Disabled'
  }
}

resource managedRedisDb 'Microsoft.Cache/redisEnterprise/databases@2025-04-01' = if (redisMode == 'managed') {
  parent: managedRedis
  name: 'default'
  properties: {
    clientProtocol: 'Encrypted'
    port: 10000
    clusteringPolicy: 'EnterpriseCluster'
    evictionPolicy: 'NoEviction'
    accessKeysAuthentication: 'Enabled'
  }
}

// Every environment reads the Redis password from here, whichever mode.
resource redisPasswordSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: kv
  name: 'redis-password'
  properties: {
    value: redisMode == 'managed' ? managedRedisDb.listKeys().primaryKey : redisPassword
  }
}

output containerAppsEnvironmentName string = cae.name
output containerAppsEnvironmentId string = cae.id
output customDomainVerificationId string = cae.properties.customDomainConfiguration.customDomainVerificationId
output staticOutboundIp string = cae.properties.staticIp
output keyVaultName string = kv.name
output postgresServerName string = postgres.outputs.serverName
output postgresFqdn string = postgres.outputs.fqdn
output redisHost string = redisMode == 'managed' ? managedRedis.properties.hostName : 'rhemapod-${platformName}-redis'
output trustedProxyCidr string = infrastructureSubnetPrefix
