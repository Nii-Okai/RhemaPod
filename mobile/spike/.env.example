# Backend API this spike calls directly (unauthenticated — the W0.1 test
# sermon is free content, and GET /sermons/{id}/stream + .../download/audio
# both accept an optional/anonymous user, so no sign-in flow is needed here).
#
# On iOS Simulator, "localhost" reaches a backend running on your Mac.
# On Android Emulator, the emulator's own loopback is 10.0.2.2, not
# localhost — use that instead if you're on Android:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# The W0.1 test sermon's UUID (not the Stream UID — stream_uid lives on
# media_refs, joined to sermons, since video/audio are separate Stream
# ingests; app/models/models.py:269). Find it with:
#   docker compose exec -T postgres psql -U sermon -d sermon -c \
#     "select s.id, s.title from sermons s join media_refs m on m.sermon_id = s.id \
#      where m.stream_uid = '9a643f36f98569c72bcb995248a7bc85';"
# or read it off whichever status.md W0.1/W1.x entry recorded it.
EXPO_PUBLIC_TEST_SERMON_ID=
