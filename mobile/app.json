{
  "expo": {
    "name": "RhemaPod",
    "slug": "rhemapod-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.niitech.rhemapod",
      "appleTeamId": "FAND2W5VMM",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "RhemaPod uses your local network to find Chromecast and Google TV devices to cast sermons to.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1725"
      },
      "package": "com.niitech.rhemapod",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RhemaPod needs access to your photos to set a profile picture.",
          "cameraPermission": "RhemaPod needs access to your camera to take a profile picture."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.827558560538-ujevidt1217i6a2gu8fm9sn8je755kta"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1725"
          }
        }
      ],
      "react-native-google-cast",
      "expo-apple-authentication"
    ],
    "scheme": "rhemapod",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "94c017d2-4c66-4c78-bb13-ee0f60f0543f"
      }
    },
    "owner": "wedid-system"
  }
}
