# Backend API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Stream: deliberately NO vars here. Every EXPO_PUBLIC_* value is inlined
# into the shipped JS bundle and is readable by anyone with the app. Playback URLs are
# signed server-side (CF_STREAM_SIGNING_KEY_* in the backend env); the app only ever
# receives short-lived signed URLs from the API.

# Google Sign-In OAuth client IDs (Google Cloud Console — Credentials). Isaac is creating
# these himself; placeholders here are a drop-in once he sends the real values. The iOS
# client ID also needs its *reversed* form pasted into app.json's
# `@react-native-google-signin/google-signin` plugin config (`iosUrlScheme`) — see that
# file's own comment — which needs a dev-client rebuild to take effect.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Origin of the https share links (optional; defaults to https://open.rhemapod.com). Only set
# this to point shares at another host, e.g. a staging copy of the static share site.
# EXPO_PUBLIC_SHARE_BASE_URL=https://open.rhemapod.com

# Crash and performance reporting (Sentry). Leave blank to turn it off. The DSN only
# allows sending events, so it is safe in the bundle. For readable stack traces from
# release builds, also set SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT as EAS
# secrets (not EXPO_PUBLIC_*): the build uploads source maps with them.
EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
