# Backend API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Stream (populated after M1)
EXPO_PUBLIC_STREAM_ACCOUNT_ID=
EXPO_PUBLIC_STREAM_SIGNING_KEY_ID=
EXPO_PUBLIC_STREAM_TOKEN_TTL=3600

# Google Sign-In OAuth client IDs (Google Cloud Console — Credentials). Isaac is creating
# these himself; placeholders here are a drop-in once he sends the real values. The iOS
# client ID also needs its *reversed* form pasted into app.json's
# `@react-native-google-signin/google-signin` plugin config (`iosUrlScheme`) — see that
# file's own comment — which needs a dev-client rebuild to take effect.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
