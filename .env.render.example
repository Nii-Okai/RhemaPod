# RhemaPod — Render STAGING environment reference (DEPLOYMENT-RENDER.md).
#
# Placeholders only. Never commit real values. On Render you do not upload this
# file: render.yaml sets everything in sections A–C, and you type the section D
# secrets into the prompt Render shows on first Blueprint sync (or paste them via
# the API service → Environment → "Add from .env").

# ── A. Set by render.yaml (env group `rhemapod-staging`) — listed for reference ──
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
# SECRET_KEY is generated by Render (generateValue). Never reuse the dev key.
SECRET_KEY=<generated-by-render>
FRONTEND_BASE_URL=https://admin.rhemapod.com
ALLOWED_ORIGINS=["https://admin.rhemapod.com"]
TRUSTED_PROXIES=["10.0.0.0/8"]
REQUIRE_EMAIL_VERIFICATION=true
OAUTH_GOOGLE_ENABLED=true
GOOGLE_OAUTH_CLIENT_IDS=<android-client-id>,<ios-client-id>,<web-client-id>
OAUTH_APPLE_ENABLED=true
OBJECT_STORE_RAW_BUCKET=sermon-raw-staging
OBJECT_STORE_MEDIA_BUCKET=sermon-media-staging
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_FROM_EMAIL=RhemaPod <no-reply@rhemapod.com>
SMTP_USE_TLS=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── B. Wired by render.yaml from Render resources (per service) ──────────────────
# Render's internal URL is postgresql://…; the app rewrites it to
# postgresql+psycopg://… itself, so paste nothing here.
DATABASE_URL=<from rhemapod-staging-db: connectionString>
REDIS_URL=<from rhemapod-staging-kv: connectionString>
PORT=8000

# ── C. Admin portal service only (render.yaml) ───────────────────────────────────
NODE_VERSION=24
API_BASE_URL=http://rhemapod-api-staging:8000
PORTAL_ORIGIN=https://admin.rhemapod.com
# CLIENT_IP_HEADER is deliberately unset on staging (see guide §6).

# ── D. SECRETS — you enter these on the API service (sync: false) ────────────────
# Cloudflare R2: a token scoped to the two *-staging buckets only (Object Read & Write).
OBJECT_STORE_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
OBJECT_STORE_ACCESS_KEY_ID=<r2-staging-access-key-id>
OBJECT_STORE_SECRET_ACCESS_KEY=<r2-staging-secret-access-key>
# Resend API key (a staging-only key, so it can be revoked on its own).
SMTP_PASSWORD=<resend-api-key>

# ── E. Not set on staging (stubs) — required before ENVIRONMENT=production ──────
# CF_ACCOUNT_ID=
# CF_STREAM_API_TOKEN=
# CF_STREAM_CUSTOMER_SUBDOMAIN=
# CF_STREAM_WEBHOOK_SECRET=
# CF_STREAM_SIGNING_KEY_ID=
# CF_STREAM_SIGNING_KEY_PEM=
# ARCHIVE_STORE_BUCKET=
# ARCHIVE_STORE_REGION=
# ARCHIVE_STORE_ACCESS_KEY_ID=
# ARCHIVE_STORE_SECRET_ACCESS_KEY=
# ARCHIVE_STORE_STORAGE_CLASS=DEEP_ARCHIVE

# ── F. One-off, set only in the Render Shell session that runs the seed ─────────
# STAFF_ADMIN_PASSWORD=   (and the other STAFF_*_PASSWORD vars seed_staff reads)
