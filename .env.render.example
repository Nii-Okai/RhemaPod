# RhemaPod — Render DEV deployment environment reference (DEPLOYMENT-RENDER.md).
#
# Placeholders only — this file is committed. Your filled copy is `.env.render`
# (gitignored by `.env.*`), built from the same values your local dev stack
# uses (.env + docker-compose.override.yml). Paste ONLY section D of it into the
# API service: Render → rhemapod-dev-api → Environment → "Add from .env".

# ── A. Set by render.yaml (env group `rhemapod-dev`) — listed for reference ──────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_BASE_URL=https://admin.rhemapod.com
ALLOWED_ORIGINS=["https://admin.rhemapod.com"]
TRUSTED_PROXIES=["10.0.0.0/8"]
GOOGLE_OAUTH_CLIENT_IDS=<android-client-id>,<ios-client-id>,<web-client-id>
OAUTH_APPLE_ENABLED=true
APPLE_REVOCATION_BACKEND=http
APPLE_TEAM_ID=FAND2W5VMM
APPLE_KEY_ID=F8JN4PAKLB
OBJECT_STORE_RAW_BUCKET=sermon-raw-dev
OBJECT_STORE_MEDIA_BUCKET=sermon-media-dev
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_FROM_EMAIL=RhemaPod <no-reply@rhemapod.com>
SMTP_USE_TLS=true
REDIS_CONNECT_TIMEOUT_SECONDS=10
REDIS_SOCKET_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── B. Wired by render.yaml from Render resources ────────────────────────────────
# Render's URL is postgresql://…; the app rewrites it to postgresql+psycopg://.
DATABASE_URL=<from rhemapod-dev-db: connectionString>
PORT=8000

# ── C. Admin portal service only (render.yaml) ───────────────────────────────────
NODE_VERSION=24
API_BASE_URL=https://api.rhemapod.com
PORTAL_ORIGIN=https://admin.rhemapod.com
# CLIENT_IP_HEADER deliberately unset (guide §6).

# ── D. SECRETS — the API service (sync: false). Same values as local dev. ───────
# REDIS_URL: rhemapod-dev-kv → Connect → External (rediss://…). Not a local value.
REDIS_URL=rediss://red-<id>:<password>@frankfurt-keyvalue.render.com:6379
SECRET_KEY=<your-local-dev-SECRET_KEY>
OBJECT_STORE_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
OBJECT_STORE_ACCESS_KEY_ID=<r2-dev-access-key-id>
OBJECT_STORE_SECRET_ACCESS_KEY=<r2-dev-secret-access-key>
SMTP_PASSWORD=<resend-api-key>
# The .p8 contents on one line, newlines written as \n (DEPLOYMENT.md §14).
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<base64 lines>\n-----END PRIVATE KEY-----"

# ── E. Not set (stubs in development) ────────────────────────────────────────────
# Cloudflare Stream (CF_*) and the Glacier archive (ARCHIVE_STORE_*) stay on
# their in-process stubs, exactly as in local dev.
