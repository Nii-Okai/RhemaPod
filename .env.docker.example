# Local Docker env for `docker compose`. Copy this to `.env` in the repo root
# and fill in SECRET_KEY:
#
#     cp .env.docker.example .env
#
# Compose auto-loads `.env` for ${VAR} substitution in docker-compose.yml.
# DATABASE_URL and REDIS_URL already have working defaults in docker-compose.yml,
# so the only value you MUST provide is SECRET_KEY (below). `docker compose up`
# refuses to start until it is set.
#
# DEV-ONLY values. Nothing here is a real secret. Deployed environments inject
# real env vars / secrets-manager values and never use a file on disk.

# Required — no default. Generate a real random value:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app's config validator (app/core/config.py) rejects placeholder and
# low-entropy keys in every environment, so a made-up string will not boot.
SECRET_KEY=

# Points at the `postgres` service on the compose network (psycopg3 async driver).
DATABASE_URL=postgresql+psycopg://sermon:sermon@postgres:5432/sermon

# Points at the `redis` service on the compose network.
REDIS_URL=redis://redis:6379/0

# uvicorn worker processes inside the api container. Default 1 — one process per
# container; scale by adding replicas, not workers.
UVICORN_WORKERS=1
